{
  // Cloudflare Workers config: serves the public/ folder as a static site.
  // public/index.html is generated by `php artisan site:export` (commit it after every page change).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mosaicfx-official-web-page",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
